# Default-deny: every tracked file must be explicitly allowlisted below.
**

# Root files
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.markdownlint-cli2.jsonc
!/.pre-commit-config.yaml
!/.release-please-manifest.json
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/SUPPORT.md
!/release-please-config.json

# Tracked directories
!/.github/
!/.github/workflows/
!/docs/
!/docs/decision-records/
!/docs/decision-records/org/
!/docs/decision-records/repo/
!/docs/decision-records/template/
!/docs/explanation/
!/docs/how-to/
!/docs/reference/
!/docs/tutorials/
!/terraform/
!/terraform/private/
!/terraform/public/
!/tests/
!/tests/fixtures/
!/tests/fixtures/terraform/
!/tests/fixtures/terraform/private/

# GitHub metadata and workflows
!/.github/CODEOWNERS
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/renovate.json5
!/.github/workflows/auto-merge.yaml
!/.github/workflows/drift-gate.yaml
