# Default-deny: every tracked file must be explicitly allowlisted below.
**

# Root files
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.markdownlint-cli2.jsonc
!/.pre-commit-config.yaml
!/.release-please-manifest.json
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/SUPPORT.md
!/release-please-config.json

# Tracked directories
!/.github/
!/.github/workflows/
!/docs/
!/docs/decision-records/
!/docs/decision-records/org/
!/docs/decision-records/repo/
!/docs/explanation/
!/docs/how-to/
!/docs/reference/
!/docs/tutorials/
!/terraform/
!/terraform/private/
!/terraform/public/
!/tests/
!/tests/fixtures/
!/tests/fixtures/terraform/
!/tests/fixtures/terraform/private/

# GitHub metadata and workflows
!/.github/CODEOWNERS
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/renovate.json5
!/.github/workflows/auto-merge.yaml
!/.github/workflows/drift-gate.yaml
!/.github/workflows/pr-validation.yaml
!/.github/workflows/release.yaml
!/.github/workflows/reusable-auto-merge.yaml
!/.github/workflows/security.yaml
!/.github/workflows/terraform-deploy.yaml

# Documentation
!/docs/README.md
!/docs/decision-records/README.md
!/docs/decision-records/org/.gitkeep
!/docs/decision-records/org/*.md
!/docs/decision-records/repo/.gitkeep
!/docs/explanation/.gitkeep
!/docs/explanation/*.md
!/docs/how-to/.gitkeep
!/docs/how-to/*.md
!/docs/reference/.gitkeep
!/docs/reference/*.md
!/docs/tutorials/.gitkeep

# Runner inventory and public-safe private fixtures
!/terraform/private/.gitkeep
!/terraform/public/.gitkeep
!/terraform/public/*.yml
!/terraform/public/*.yaml
!/tests/fixtures/.gitkeep
!/tests/fixtures/terraform/private/.gitkeep
!/tests/fixtures/terraform/private/*.yml
!/tests/fixtures/terraform/private/*.yaml
